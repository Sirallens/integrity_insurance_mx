---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.svelte';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Integrity Mexico Insurance - Frequently Asked Questions"
  description="Everything you need to know about driving in Mexico safely.  Find answers about coverage, border crossing, and claims."
>
  <Navigation client:load />

  <main class="flex-grow">
    <!-- Hero Section with Search -->
    <div class="relative bg-primary/5 dark:bg-primary/10 pt-16 pb-24 border-b border-slate-200 dark:border-slate-800">
      <!-- Decorative Background Element -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="absolute -top-24 -right-24 w-96 h-96 bg-primary/10 rounded-full blur-3xl"></div>
        <div class="absolute top-1/2 -left-24 w-72 h-72 bg-blue-400/10 rounded-full blur-3xl"></div>
      </div>

      <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span class="inline-block py-1 px-3 rounded-full bg-primary/10 text-primary text-sm font-semibold mb-4 border border-primary/20">Help Center</span>
        <h1 class="text-4xl md:text-5xl font-bold text-slate-900 dark:text-white mb-6">Frequently Asked Questions</h1>
        <p class="text-lg text-slate-600 dark:text-slate-300 mb-10 max-w-2xl mx-auto">
          Everything you need to know about driving in Mexico safely. Find answers about coverage, border crossing, and claims.
        </p>

        <!-- Search Bar -->
        <div class="relative max-w-2xl mx-auto group">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
            <span class="material-icons text-slate-400 group-focus-within:text-primary transition-colors">search</span>
          </div>
          <input 
            class="block w-full pl-12 pr-4 py-4 bg-white dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:border-primary focus:ring-4 focus:ring-primary/10 transition-all shadow-sm" 
            placeholder="Search for answers (e.g., claims, border crossing)..." 
            type="text"
          />
          <div class="absolute inset-y-0 right-2 flex items-center">
            <button class="bg-primary hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors">
              Search
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- FAQ Content Section -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 -mt-12 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <!-- Sidebar Categories -->
        <div class="lg:col-span-3">
          <div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-800 p-2 sticky top-24">
            <nav class="space-y-1">
              <a class="flex items-center gap-3 px-4 py-3 bg-primary/10 text-primary rounded-lg font-medium transition-colors" href="#general">
                <span class="material-icons text-sm">verified_user</span>
                General Coverage
              </a>
              <a class="flex items-center gap-3 px-4 py-3 text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white rounded-lg font-medium transition-colors" href="#border">
                <span class="material-icons text-sm">commute</span>
                Border Crossing
              </a>
              <a class="flex items-center gap-3 px-4 py-3 text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white rounded-lg font-medium transition-colors" href="#claims">
                <span class="material-icons text-sm">gavel</span>
                Claims & Accidents
              </a>
              <a class="flex items-center gap-3 px-4 py-3 text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white rounded-lg font-medium transition-colors" href="#policy">
                <span class="material-icons text-sm">description</span>
                Policy Details
              </a>
            </nav>

            <!-- Quick Help Card -->
            <div class="mt-6 p-4 bg-primary rounded-lg text-white mx-2 mb-2">
              <div class="flex items-center gap-2 mb-2">
                <span class="material-icons">support_agent</span>
                <span class="font-bold">Need assistance?</span>
              </div>
              <p class="text-sm text-blue-100 mb-3">Our bilingual agents are ready to help you 24/7.</p>
              <a class="inline-block w-full text-center bg-white text-primary text-sm font-bold py-2 rounded shadow hover:bg-blue-50 transition-colors" href="/contact">
                Contact Support
              </a>
            </div>
          </div>
        </div>

        <!-- Accordion Content -->
        <div class="lg:col-span-9 space-y-8">
          <!-- Section: General Coverage -->
          <div id="general">
            <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-6 flex items-center gap-2">
              <span class="w-8 h-8 rounded-full bg-blue-100 dark:bg-blue-900/30 text-primary flex items-center justify-center">
                <span class="material-icons text-lg">verified_user</span>
              </span>
              General Coverage
            </h2>
            <div class="space-y-4">
              <!-- Question 1 -->
              <details class="group bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden transition-all duration-300 hover:shadow-md" open>
                <summary class="flex items-center justify-between p-6 cursor-pointer bg-white dark:bg-slate-900 group-hover:bg-slate-50 dark:group-hover:bg-slate-800/50 transition-colors">
                  <h3 class="text-lg font-semibold text-slate-900 dark:text-white pr-4">Does my U.S. insurance cover me in Mexico?</h3>
                  <span class="material-icons text-primary transition-transform duration-300 group-open:rotate-180">expand_more</span>
                </summary>
                <div class="px-6 pb-6 text-slate-600 dark:text-slate-300 leading-relaxed border-t border-slate-100 dark:border-slate-800/50 pt-4">
                  <p class="mb-3"><strong class="text-slate-900 dark:text-white">Short Answer: No.</strong> Most U.S. auto insurance policies do not provide valid liability coverage in Mexico.</p>
                  <p>Mexican law requires proof of financial responsibility from a Mexican insurer. Even if your U.S. policy offers some limited coverage for physical damage within a certain distance of the border, it is not recognized by Mexican authorities for liability. Without a Mexican policy, you could face legal detention or vehicle confiscation if involved in an accident.</p>
                </div>
              </details>

              <!-- Question 2 -->
              <details class="group bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden transition-all duration-300 hover:shadow-md">
                <summary class="flex items-center justify-between p-6 cursor-pointer bg-white dark:bg-slate-900 group-hover:bg-slate-50 dark:group-hover:bg-slate-800/50 transition-colors">
                  <h3 class="text-lg font-semibold text-slate-900 dark:text-white pr-4">What types of vehicles can I insure?</h3>
                  <span class="material-icons text-primary transition-transform duration-300 group-open:rotate-180">expand_more</span>
                </summary>
                <div class="px-6 pb-6 text-slate-600 dark:text-slate-300 leading-relaxed border-t border-slate-100 dark:border-slate-800/50 pt-4">
                  <p>We offer coverage for a wide range of personal vehicles including cars, SUVs, pickup trucks, RVs, motorhomes, and motorcycles. Your vehicle must be registered outside of Mexico (e.g., USA or Canada) to be eligible for our tourist policies.</p>
                </div>
              </details>
            </div>
          </div>

          <!-- Section: Claims & Accidents -->
          <div id="claims">
            <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-6 flex items-center gap-2 pt-4">
              <span class="w-8 h-8 rounded-full bg-blue-100 dark:bg-blue-900/30 text-primary flex items-center justify-center">
                <span class="material-icons text-lg">gavel</span>
              </span>
              Claims & Accidents
            </h2>
            <div class="space-y-4">
              <!-- Question 3 -->
              <details class="group bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden transition-all duration-300 hover:shadow-md">
                <summary class="flex items-center justify-between p-6 cursor-pointer bg-white dark:bg-slate-900 group-hover:bg-slate-50 dark:group-hover:bg-slate-800/50 transition-colors">
                  <h3 class="text-lg font-semibold text-slate-900 dark:text-white pr-4">What do I do if I have an accident?</h3>
                  <span class="material-icons text-primary transition-transform duration-300 group-open:rotate-180">expand_more</span>
                </summary>
                <div class="px-6 pb-6 text-slate-600 dark:text-slate-300 leading-relaxed border-t border-slate-100 dark:border-slate-800/50 pt-4">
                  <ol class="list-decimal pl-5 space-y-2 mb-4">
                    <li><strong>Ensure Safety:</strong> Check for injuries and move to a safe location if possible.</li>
                    <li><strong>Call the Hotline:</strong> Call the toll-free claims number listed on your policy immediately. This number is available 24/7.</li>
                    <li><strong>Do Not Negotiate:</strong> Do not admit fault or make payments to other parties until you have spoken with the insurance adjuster.</li>
                    <li><strong>Wait for Adjuster:</strong> In Mexico, an adjuster will typically come to the scene of the accident.</li>
                  </ol>
                  <p class="text-sm bg-blue-50 dark:bg-blue-900/20 p-3 rounded text-blue-800 dark:text-blue-200">
                    <span class="font-bold">Important:</span> You must report the claim while you are still in Mexico.
                  </p>
                </div>
              </details>

              <!-- Question 4 -->
              <details class="group bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden transition-all duration-300 hover:shadow-md">
                <summary class="flex items-center justify-between p-6 cursor-pointer bg-white dark:bg-slate-900 group-hover:bg-slate-50 dark:group-hover:bg-slate-800/50 transition-colors">
                  <h3 class="text-lg font-semibold text-slate-900 dark:text-white pr-4">How are claims handled? Do I need to speak Spanish?</h3>
                  <span class="material-icons text-primary transition-transform duration-300 group-open:rotate-180">expand_more</span>
                </summary>
                <div class="px-6 pb-6 text-slate-600 dark:text-slate-300 leading-relaxed border-t border-slate-100 dark:border-slate-800/50 pt-4">
                  <p>Claims are handled by our partner insurers in Mexico, but the initial reporting line offers <strong class="text-primary">bilingual support</strong>. You do not need to be fluent in Spanish to report a claim. Our team and the adjusters are accustomed to working with U.S. tourists and will guide you through the process in English.</p>
                </div>
              </details>
            </div>
          </div>

          <!-- Section: Border Crossing -->
          <div id="border">
            <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-6 flex items-center gap-2 pt-4">
              <span class="w-8 h-8 rounded-full bg-blue-100 dark:bg-blue-900/30 text-primary flex items-center justify-center">
                <span class="material-icons text-lg">commute</span>
              </span>
              Border Crossing
            </h2>
            <div class="space-y-4">
              <!-- Question 5 -->
              <details class="group bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden transition-all duration-300 hover:shadow-md">
                <summary class="flex items-center justify-between p-6 cursor-pointer bg-white dark:bg-slate-900 group-hover:bg-slate-50 dark:group-hover:bg-slate-800/50 transition-colors">
                  <h3 class="text-lg font-semibold text-slate-900 dark:text-white pr-4">Can I buy a policy at the border?</h3>
                  <span class="material-icons text-primary transition-transform duration-300 group-open:rotate-180">expand_more</span>
                </summary>
                <div class="px-6 pb-6 text-slate-600 dark:text-slate-300 leading-relaxed border-t border-slate-100 dark:border-slate-800/50 pt-4">
                  <p class="mb-2">Technically, yes, there are kiosks at some borders. However, we <strong class="text-slate-900 dark:text-white">strongly recommend buying online beforehand</strong> for several reasons:</p>
                  <ul class="list-disc pl-5 space-y-1">
                    <li>You avoid long lines and delays at the crossing.</li>
                    <li>Online rates are typically better than "last-minute" kiosk pricing.</li>
                    <li>You can read the policy details carefully in English without pressure.</li>
                    <li>Your policy is active the moment you cross, ensuring zero gaps in coverage.</li>
                  </ul>
                </div>
              </details>

              <!-- Question 6 -->
              <details class="group bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden transition-all duration-300 hover:shadow-md">
                <summary class="flex items-center justify-between p-6 cursor-pointer bg-white dark:bg-slate-900 group-hover:bg-slate-50 dark:group-hover:bg-slate-800/50 transition-colors">
                  <h3 class="text-lg font-semibold text-slate-900 dark:text-white pr-4">What documents do I need to drive into Mexico?</h3>
                  <span class="material-icons text-primary transition-transform duration-300 group-open:rotate-180">expand_more</span>
                </summary>
                <div class="px-6 pb-6 text-slate-600 dark:text-slate-300 leading-relaxed border-t border-slate-100 dark:border-slate-800/50 pt-4">
                  <p>Generally, you will need:</p>
                  <ul class="list-disc pl-5 space-y-1 mt-2">
                    <li>A valid U.S. or Canadian Driver's License.</li>
                    <li>Your vehicle registration document.</li>
                    <li>Proof of Mexican Auto Insurance (printed or digital).</li>
                    <li>For travel outside the "Free Zone," you may need a Temporary Vehicle Importation Permit (TIP).</li>
                  </ul>
                </div>
              </details>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Still Need Help Section -->
    <div class="bg-white dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800 mt-16 py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-primary/5 dark:bg-slate-800 rounded-2xl p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-8 border border-primary/10">
          <div class="flex-1">
            <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-3">Still have questions?</h2>
            <p class="text-slate-600 dark:text-slate-300 mb-6 max-w-lg">
              Can't find the answer you're looking for? Please chat to our friendly team. We're here to help you drive with confidence.
            </p>
            <div class="flex flex-wrap gap-4">
              <a class="inline-flex items-center gap-2 bg-primary hover:bg-blue-700 text-white px-6 py-3 rounded-lg font-semibold transition-colors" href="/contact">
                <span class="material-icons text-sm">chat</span>
                Start Live Chat
              </a>
              <a class="inline-flex items-center gap-2 bg-white dark:bg-slate-700 hover:bg-slate-50 dark:hover:bg-slate-600 text-slate-700 dark:text-white border border-slate-200 dark:border-slate-600 px-6 py-3 rounded-lg font-semibold transition-colors" href="/contact">
                <span class="material-icons text-sm">email</span>
                Email Us
              </a>
            </div>
          </div>

          <!-- Illustrative Image -->
          <div class="relative w-full md:w-1/3 aspect-[4/3] rounded-xl overflow-hidden shadow-lg">
            <img 
              alt="Customer support team member smiling and talking on headset" 
              class="w-full h-full object-cover" 
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuAZFiQN001vMh4wZs0i_muxW5Xw8pM4rMAGPis6d8Uka9BoLrStvgIK4BBY4e7225y9WETE0Qi_gkkZ1SUGG81zhAqVeTHOUrrqI6iQ7zTHfxNJlN7fRRpWBe1X-c6r75s2U2ZbOmvuNdj2QIV7l5WnCqmirEPqkssqmIuYRwlsXkcw2lQ0z22qijohcJtaTX1o_ijyOX3osDJx1Afy7aiPrAYg0PVnoUPYmX92qjsfpghOJrwCxO-dGw294uM37VA3IbmSL6oRTxjE"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent flex items-end p-6">
              <div class="text-white">
                <p class="font-bold text-lg">We're here for you</p>
                <p class="text-sm opacity-90">Mon-Fri, 9am - 6pm EST</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* Smooth accordion transitions */
  details > summary {
    list-style: none;
  }
  details > summary::-webkit-details-marker {
    display: none;
  }
  details[open] summary ~ * {
    animation: sweep .3s ease-in-out;
  }
  @keyframes sweep {
    0%    {opacity: 0; transform: translateY(-10px)}
    100%  {opacity: 1; transform: translateY(0)}
  }
</style>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navigation from "../../components/Navigation.svelte";
import Footer from "../../components/Footer.astro";
---

<BaseLayout
  title="Integrity Mexico Seguros - Preguntas Frecuentes"
  description="Todo lo que necesita saber sobre conducir en México de manera segura. Encuentre respuestas sobre cobertura, cruce fronterizo y reclamaciones."
>
  <Navigation lang="es" client:load />

  <main class="flex-grow">
    <!-- Hero Section with Search -->
    <div
      class="relative bg-primary/5 dark:bg-primary/10 pt-16 pb-16 border-b border-slate-200 dark:border-slate-800 align-center"
    >
      <!-- Decorative Background Element -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div
          class="absolute -top-24 -right-24 w-96 h-96 bg-primary/10 rounded-full blur-3xl"
        >
        </div>
        <div
          class="absolute top-1/2 -left-24 w-72 h-72 bg-blue-400/10 rounded-full blur-3xl"
        >
        </div>
      </div>

      <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span
          class="inline-block py-1 px-3 rounded-full bg-primary/10 text-primary text-sm font-semibold mb-4 border border-primary/20"
          >Centro de Ayuda</span
        >
        <h1
          class="text-4xl md:text-5xl font-bold text-slate-900 dark:text-white mb-6"
        >
          Preguntas Frecuentes
        </h1>
        <p
          class="text-lg text-slate-600 dark:text-slate-300 mb-10 max-w-2xl mx-auto"
        >
          Todo lo que necesita saber sobre conducir en México de manera segura.
          Encuentre respuestas sobre cobertura, cruce fronterizo y
          reclamaciones.
        </p>

        <!-- Search Bar -->
        <div class="relative max-w-2xl mx-auto group hidden">
          <div
            class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none"
          >
            <span
              class="material-icons text-slate-400 group-focus-within:text-primary transition-colors"
              >search</span
            >
          </div>
          <input
            class="block w-full pl-12 pr-4 py-4 bg-white dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:border-primary focus:ring-4 focus:ring-primary/10 transition-all shadow-sm"
            placeholder="Buscar respuestas (ej. reclamaciones, cruce fronterizo)..."
            type="text"
          />
          <div class="absolute inset-y-0 right-2 flex items-center">
            <button
              class="bg-primary hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors"
            >
              Buscar
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- FAQ Content Section -->
    <div
      class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 -mt-12 relative z-10"
    >
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <!-- Sidebar Categories -->
        <div class="lg:col-span-3">
          <div
            class="bg-white dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-800 p-2 sticky top-24"
          >
            <nav class="space-y-1">
              <a
                class="flex items-center gap-3 px-4 py-3 bg-primary/10 text-primary rounded-lg font-medium transition-colors"
                href="#general"
              >
                <span class="material-icons text-sm">verified_user</span>
                Preguntas Generales
              </a>
              <a
                class="flex items-center gap-3 px-4 py-3 text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white rounded-lg font-medium transition-colors"
                href="#coverage"
              >
                <span class="material-icons text-sm">shield</span>
                Preguntas de Cobertura
              </a>
              <a
                class="flex items-center gap-3 px-4 py-3 text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white rounded-lg font-medium transition-colors"
                href="#vehicle"
              >
                <span class="material-icons text-sm">directions_car</span>
                Vehículo y Conductor
              </a>
              <a
                class="flex items-center gap-3 px-4 py-3 text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white rounded-lg font-medium transition-colors"
                href="#travel"
              >
                <span class="material-icons text-sm">map</span>
                Preguntas de Viaje
              </a>
              <a
                class="flex items-center gap-3 px-4 py-3 text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white rounded-lg font-medium transition-colors"
                href="#purchasing"
              >
                <span class="material-icons text-sm">shopping_cart</span>
                Preguntas de Compra
              </a>
              <a
                class="flex items-center gap-3 px-4 py-3 text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white rounded-lg font-medium transition-colors"
                href="#claims"
              >
                <span class="material-icons text-sm">support_agent</span>
                Reclamaciones y Asistencia
              </a>
            </nav>

            <!-- Quick Help Card -->
            <div class="mt-6 p-4 bg-primary rounded-lg text-white mx-2 mb-2">
              <div class="flex items-center gap-2 mb-2">
                <span class="material-icons">support_agent</span>
                <span class="font-bold">¿Necesita asistencia?</span>
              </div>
              <p class="text-sm text-blue-100 mb-3">
                Nuestros agentes bilingües están listos para ayudarlo 24/7.
              </p>
              <a
                class="inline-block w-full text-center bg-white text-primary text-sm font-bold py-2 rounded shadow hover:bg-blue-50 transition-colors"
                href="/es/contact"
              >
                Contactar Soporte
              </a>
            </div>
          </div>
        </div>

        <!-- Accordion Content -->
        <div class="lg:col-span-9 space-y-8">
          <!-- Section: General Questions -->
          <div id="general">
            <h2
              class="text-2xl font-bold text-slate-900 dark:text-white mb-6 flex items-center gap-2"
            >
              <span
                class="w-8 h-8 rounded-full bg-blue-100 dark:bg-blue-900/30 text-primary flex items-center justify-center"
              >
                <span class="material-icons text-lg">verified_user</span>
              </span>
              Preguntas Generales
            </h2>
            <div class="space-y-4">
              <details
                class="group bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden transition-all duration-300 hover:shadow-md"
                open
              >
                <summary
                  class="flex items-center justify-between p-6 cursor-pointer bg-white dark:bg-slate-900 group-hover:bg-slate-50 dark:group-hover:bg-slate-800/50 transition-colors"
                >
                  <h3
                    class="text-lg font-semibold text-slate-900 dark:text-white pr-4"
                  >
                    ¿Qué es el Seguro de Auto Turista para México?
                  </h3>
                  <span
                    class="material-icons text-primary transition-transform duration-300 group-open:rotate-180"
                    >expand_more</span
                  >
                </summary>
                <div
                  class="px-6 pb-6 text-slate-600 dark:text-slate-300 leading-relaxed border-t border-slate-100 dark:border-slate-800/50 pt-4"
                >
                  <p>
                    El Seguro de Auto Turista para México es una póliza de
                    seguro temporal que proporciona cobertura de responsabilidad
                    civil y daños físicos para vehículos que se conducen desde
                    los Estados Unidos o Canadá hacia México.
                  </p>
                </div>
              </details>
              <details
                class="group bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden transition-all duration-300 hover:shadow-md"
              >
                <summary
                  class="flex items-center justify-between p-6 cursor-pointer bg-white dark:bg-slate-900 group-hover:bg-slate-50 dark:group-hover:bg-slate-800/50 transition-colors"
                >
                  <h3
                    class="text-lg font-semibold text-slate-900 dark:text-white pr-4"
                  >
                    ¿Necesito seguro mexicano si ya tengo seguro de auto de EE.
                    UU.?
                  </h3>
                  <span
                    class="material-icons text-primary transition-transform duration-300 group-open:rotate-180"
                    >expand_more</span
                  >
                </summary>
                <div
                  class="px-6 pb-6 text-slate-600 dark:text-slate-300 leading-relaxed border-t border-slate-100 dark:border-slate-800/50 pt-4"
                >
                  <p>
                    Sí. Las pólizas de seguro de auto de EE. UU. y Canadá no son
                    reconocidas legalmente en México. La ley mexicana exige
                    cobertura de responsabilidad civil emitida por una
                    aseguradora mexicana.
                  </p>
                </div>
              </details>
              <details
                class="group bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden transition-all duration-300 hover:shadow-md"
              >
                <summary
                  class="flex items-center justify-between p-6 cursor-pointer bg-white dark:bg-slate-900 group-hover:bg-slate-50 dark:group-hover:bg-slate-800/50 transition-colors"
                >
                  <h3
                    class="text-lg font-semibold text-slate-900 dark:text-white pr-4"
                  >
                    ¿Es el Seguro Turista para México obligatorio por ley?
                  </h3>
                  <span
                    class="material-icons text-primary transition-transform duration-300 group-open:rotate-180"
                    >expand_more</span
                  >
                </summary>
                <div
                  class="px-6 pb-6 text-slate-600 dark:text-slate-300 leading-relaxed border-t border-slate-100 dark:border-slate-800/50 pt-4"
                >
                  <p>
                    Sí. La ley federal mexicana exige que los conductores lleven
                    seguro de responsabilidad civil de una aseguradora mexicana
                    cuando manejan en carreteras y caminos federales.
                  </p>
                </div>
              </details>
              <details
                class="group bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden transition-all duration-300 hover:shadow-md"
              >
                <summary
                  class="flex items-center justify-between p-6 cursor-pointer bg-white dark:bg-slate-900 group-hover:bg-slate-50 dark:group-hover:bg-slate-800/50 transition-colors"
                >
                  <h3
                    class="text-lg font-semibold text-slate-900 dark:text-white pr-4"
                  >
                    ¿Cuánto tiempo puede durar una póliza de seguro de auto
                    turista para México?
                  </h3>
                  <span
                    class="material-icons text-primary transition-transform duration-300 group-open:rotate-180"
                    >expand_more</span
                  >
                </summary>
                <div
                  class="px-6 pb-6 text-slate-600 dark:text-slate-300 leading-relaxed border-t border-slate-100 dark:border-slate-800/50 pt-4"
                >
                  <p class="mb-2">
                    Las pólizas generalmente se pueden adquirir por:
                  </p>
                  <ul class="list-disc pl-5 space-y-1">
                    <li>1 día</li>
                    <li>3 días</li>
                    <li>7 días</li>
                    <li>15 días</li>
                    <li>30 días</li>
                    <li>6 meses</li>
                    <li>1 año</li>
                  </ul>
                </div>
              </details>
              <details
                class="group bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden transition-all duration-300 hover:shadow-md"
              >
                <summary
                  class="flex items-center justify-between p-6 cursor-pointer bg-white dark:bg-slate-900 group-hover:bg-slate-50 dark:group-hover:bg-slate-800/50 transition-colors"
                >
                  <h3
                    class="text-lg font-semibold text-slate-900 dark:text-white pr-4"
                  >
                    ¿Quién puede comprar una póliza de Seguro de Auto Turista
                    para México?
                  </h3>
                  <span
                    class="material-icons text-primary transition-transform duration-300 group-open:rotate-180"
                    >expand_more</span
                  >
                </summary>
                <div
                  class="px-6 pb-6 text-slate-600 dark:text-slate-300 leading-relaxed border-t border-slate-100 dark:border-slate-800/50 pt-4"
                >
                  <p>
                    Cualquier persona que conduzca un vehículo con placas de EE.
                    UU. o Canadá hacia México puede adquirir una póliza.
                  </p>
                </div>
              </details>
            </div>
          </div>

          <!-- Section: Coverage Questions -->
          <div id="coverage">
            <h2
              class="text-2xl font-bold text-slate-900 dark:text-white mb-6 flex items-center gap-2 pt-4"
            >
              <span
                class="w-8 h-8 rounded-full bg-blue-100 dark:bg-blue-900/30 text-primary flex items-center justify-center"
              >
                <span class="material-icons text-lg">shield</span>
              </span>
              Preguntas de Cobertura
            </h2>
            <div class="space-y-4">
              <details
                class="group bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden transition-all duration-300 hover:shadow-md"
              >
                <summary
                  class="flex items-center justify-between p-6 cursor-pointer bg-white dark:bg-slate-900 group-hover:bg-slate-50 dark:group-hover:bg-slate-800/50 transition-colors"
                >
                  <h3
                    class="text-lg font-semibold text-slate-900 dark:text-white pr-4"
                  >
                    ¿Qué cubre el Seguro de Auto Turista para México?
                  </h3>
                  <span
                    class="material-icons text-primary transition-transform duration-300 group-open:rotate-180"
                    >expand_more</span
                  >
                </summary>
                <div
                  class="px-6 pb-6 text-slate-600 dark:text-slate-300 leading-relaxed border-t border-slate-100 dark:border-slate-800/50 pt-4"
                >
                  <p class="mb-2">La cobertura puede incluir:</p>
                  <ul class="list-disc pl-5 space-y-1">
                    <li>Responsabilidad civil (requerida por ley)</li>
                    <li>Daños físicos (colisión y robo)</li>
                    <li>Gastos médicos</li>
                    <li>Asistencia legal</li>
                    <li>Asistencia en carretera</li>
                    <li>Cobertura de fianza</li>
                  </ul>
                </div>
              </details>
              <details
                class="group bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden transition-all duration-300 hover:shadow-md"
              >
                <summary
                  class="flex items-center justify-between p-6 cursor-pointer bg-white dark:bg-slate-900 group-hover:bg-slate-50 dark:group-hover:bg-slate-800/50 transition-colors"
                >
                  <h3
                    class="text-lg font-semibold text-slate-900 dark:text-white pr-4"
                  >
                    ¿Qué es la cobertura de responsabilidad civil en México?
                  </h3>
                  <span
                    class="material-icons text-primary transition-transform duration-300 group-open:rotate-180"
                    >expand_more</span
                  >
                </summary>
                <div
                  class="px-6 pb-6 text-slate-600 dark:text-slate-300 leading-relaxed border-t border-slate-100 dark:border-slate-800/50 pt-4"
                >
                  <p>
                    El seguro de responsabilidad civil cubre los daños o
                    lesiones que cause a terceros. Esta cobertura es obligatoria
                    en México.
                  </p>
                </div>
              </details>
              <details
                class="group bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden transition-all duration-300 hover:shadow-md"
              >
                <summary
                  class="flex items-center justify-between p-6 cursor-pointer bg-white dark:bg-slate-900 group-hover:bg-slate-50 dark:group-hover:bg-slate-800/50 transition-colors"
                >
                  <h3
                    class="text-lg font-semibold text-slate-900 dark:text-white pr-4"
                  >
                    ¿La póliza cubre el robo de mi vehículo?
                  </h3>
                  <span
                    class="material-icons text-primary transition-transform duration-300 group-open:rotate-180"
                    >expand_more</span
                  >
                </summary>
                <div
                  class="px-6 pb-6 text-slate-600 dark:text-slate-300 leading-relaxed border-t border-slate-100 dark:border-slate-800/50 pt-4"
                >
                  <p>
                    Sí, si contrata cobertura amplia que incluye protección
                    contra robo.
                  </p>
                </div>
              </details>
              <details
                class="group bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden transition-all duration-300 hover:shadow-md"
              >
                <summary
                  class="flex items-center justify-between p-6 cursor-pointer bg-white dark:bg-slate-900 group-hover:bg-slate-50 dark:group-hover:bg-slate-800/50 transition-colors"
                >
                  <h3
                    class="text-lg font-semibold text-slate-900 dark:text-white pr-4"
                  >
                    ¿La póliza cubre gastos médicos?
                  </h3>
                  <span
                    class="material-icons text-primary transition-transform duration-300 group-open:rotate-180"
                    >expand_more</span
                  >
                </summary>
                <div
                  class="px-6 pb-6 text-slate-600 dark:text-slate-300 leading-relaxed border-t border-slate-100 dark:border-slate-800/50 pt-4"
                >
                  <p>
                    La mayoría de las pólizas incluyen cobertura de gastos
                    médicos para el conductor y los pasajeros.
                  </p>
                </div>
              </details>
              <details
                class="group bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden transition-all duration-300 hover:shadow-md"
              >
                <summary
                  class="flex items-center justify-between p-6 cursor-pointer bg-white dark:bg-slate-900 group-hover:bg-slate-50 dark:group-hover:bg-slate-800/50 transition-colors"
                >
                  <h3
                    class="text-lg font-semibold text-slate-900 dark:text-white pr-4"
                  >
                    ¿La póliza incluye asistencia legal?
                  </h3>
                  <span
                    class="material-icons text-primary transition-transform duration-300 group-open:rotate-180"
                    >expand_more</span
                  >
                </summary>
                <div
                  class="px-6 pb-6 text-slate-600 dark:text-slate-300 leading-relaxed border-t border-slate-100 dark:border-slate-800/50 pt-4"
                >
                  <p>
                    Sí. Muchas pólizas incluyen representación legal y cobertura
                    de fianza, lo cual es muy importante en caso de accidente en
                    México.
                  </p>
                </div>
              </details>
            </div>
          </div>

          <!-- Section: Vehicle & Driver Questions -->
          <div id="vehicle">
            <h2
              class="text-2xl font-bold text-slate-900 dark:text-white mb-6 flex items-center gap-2 pt-4"
            >
              <span
                class="w-8 h-8 rounded-full bg-blue-100 dark:bg-blue-900/30 text-primary flex items-center justify-center"
              >
                <span class="material-icons text-lg">directions_car</span>
              </span>
              Vehículo y Conductor
            </h2>
            <div class="space-y-4">
              <details
                class="group bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden transition-all duration-300 hover:shadow-md"
              >
                <summary
                  class="flex items-center justify-between p-6 cursor-pointer bg-white dark:bg-slate-900 group-hover:bg-slate-50 dark:group-hover:bg-slate-800/50 transition-colors"
                >
                  <h3
                    class="text-lg font-semibold text-slate-900 dark:text-white pr-4"
                  >
                    ¿Qué vehículos se pueden asegurar?
                  </h3>
                  <span
                    class="material-icons text-primary transition-transform duration-300 group-open:rotate-180"
                    >expand_more</span
                  >
                </summary>
                <div
                  class="px-6 pb-6 text-slate-600 dark:text-slate-300 leading-relaxed border-t border-slate-100 dark:border-slate-800/50 pt-4"
                >
                  <p class="mb-2">La mayoría de las pólizas turistas cubren:</p>
                  <ul class="list-disc pl-5 space-y-1 mb-4">
                    <li>Automóviles</li>
                    <li>SUVs</li>
                    <li>Camionetas pick-up</li>
                    <li>Casas rodantes</li>
                  </ul>
                  <p>
                    Ciertos vehículos como camiones comerciales o vehículos de
                    lujo pueden requerir pólizas especiales.
                  </p>
                </div>
              </details>
              <details
                class="group bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden transition-all duration-300 hover:shadow-md"
              >
                <summary
                  class="flex items-center justify-between p-6 cursor-pointer bg-white dark:bg-slate-900 group-hover:bg-slate-50 dark:group-hover:bg-slate-800/50 transition-colors"
                >
                  <h3
                    class="text-lg font-semibold text-slate-900 dark:text-white pr-4"
                  >
                    ¿Se pueden incluir múltiples conductores?
                  </h3>
                  <span
                    class="material-icons text-primary transition-transform duration-300 group-open:rotate-180"
                    >expand_more</span
                  >
                </summary>
                <div
                  class="px-6 pb-6 text-slate-600 dark:text-slate-300 leading-relaxed border-t border-slate-100 dark:border-slate-800/50 pt-4"
                >
                  <p>
                    Sí. La mayoría de las pólizas permiten conductores
                    adicionales siempre que tengan una licencia de conducir
                    válida.
                  </p>
                </div>
              </details>
            </div>
          </div>

          <!-- Section: Travel Questions -->
          <div id="travel">
            <h2
              class="text-2xl font-bold text-slate-900 dark:text-white mb-6 flex items-center gap-2 pt-4"
            >
              <span
                class="w-8 h-8 rounded-full bg-blue-100 dark:bg-blue-900/30 text-primary flex items-center justify-center"
              >
                <span class="material-icons text-lg">map</span>
              </span>
              Preguntas de Viaje
            </h2>
            <div class="space-y-4">
              <details
                class="group bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden transition-all duration-300 hover:shadow-md"
              >
                <summary
                  class="flex items-center justify-between p-6 cursor-pointer bg-white dark:bg-slate-900 group-hover:bg-slate-50 dark:group-hover:bg-slate-800/50 transition-colors"
                >
                  <h3
                    class="text-lg font-semibold text-slate-900 dark:text-white pr-4"
                  >
                    ¿Necesito seguro si solo manejo cerca de la frontera?
                  </h3>
                  <span
                    class="material-icons text-primary transition-transform duration-300 group-open:rotate-180"
                    >expand_more</span
                  >
                </summary>
                <div
                  class="px-6 pb-6 text-slate-600 dark:text-slate-300 leading-relaxed border-t border-slate-100 dark:border-slate-800/50 pt-4"
                >
                  <p>
                    Sí. Incluso en zonas fronterizas, la ley mexicana exige un
                    seguro de responsabilidad civil emitido por una compañía
                    mexicana.
                  </p>
                </div>
              </details>
              <details
                class="group bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden transition-all duration-300 hover:shadow-md"
              >
                <summary
                  class="flex items-center justify-between p-6 cursor-pointer bg-white dark:bg-slate-900 group-hover:bg-slate-50 dark:group-hover:bg-slate-800/50 transition-colors"
                >

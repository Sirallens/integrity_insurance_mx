---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.svelte';
import Footer from '../../components/Footer.astro';
---

<BaseLayout title="Cómo Funciona - Integrity Mexico Seguros"
  description="De la cotización a la frontera en minutos. Hemos simplificado el proceso para obtener un seguro de auto mexicano para que pueda concentrarse en su viaje, no en el papeleo.">
  <Navigation lang="es" client:load />

  <!-- Main Content -->
  <main class="py-16 sm:py-24">
    <!-- Header Section -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center mb-16 sm:mb-24">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-primary/10 text-primary mb-6">
        Simple y Seguro
      </span>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-gray-900 dark:text-white mb-6">
        Cómo Funciona: <br class="hidden sm:block" /> De la Cotización a la Frontera en Minutos
      </h1>
      <p class="mt-4 max-w-2xl mx-auto text-xl text-gray-600 dark:text-gray-400">
        Hemos simplificado el proceso de obtención de un seguro de auto mexicano para que pueda concentrarse en su viaje, no en el papeleo.
      </p>
    </div>

    <!-- Steps Section -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <!-- Visual Connector Line (Desktop Only) -->
      <div class="hidden lg:block absolute top-12 left-[10%] right-[10%] h-0.5 bg-gray-200 dark:bg-gray-800 -z-10">
      </div>
      <!-- Animated progress highlight -->
      <div
        class="hidden lg:block absolute top-12 left-[10%] right-[60%] h-0.5 bg-gradient-to-r from-primary to-primary/40 -z-10">
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8">
        <!-- Step 1 -->
        <div class="relative group">
          <div class="flex flex-col items-center text-center">
            <div class="relative mb-6">
              <div
                class="w-24 h-24 bg-white dark:bg-gray-800 rounded-2xl shadow-xl shadow-gray-200/50 dark:shadow-none flex items-center justify-center border border-gray-100 dark:border-gray-700 group-hover:border-primary/30 group-hover:-translate-y-1 transition-all duration-300">
                <span class="material-icons text-4xl text-primary">calculate</span>
              </div>
              <div
                class="absolute -top-3 -right-3 w-8 h-8 bg-primary text-white rounded-full flex items-center justify-center font-bold text-sm border-4 border-background-light dark:border-background-dark">
                1
              </div>
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">Obtenga una Cotización</h3>
            <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed px-2">
              Ingrese los detalles de su viaje y la información de su vehículo en segundos. Nuestro formulario inteligente lo hace rápido y sin complicaciones.
            </p>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="relative group">
          <div class="flex flex-col items-center text-center">
            <div class="relative mb-6">
              <div
                class="w-24 h-24 bg-white dark:bg-gray-800 rounded-2xl shadow-xl shadow-gray-200/50 dark:shadow-none flex items-center justify-center border border-gray-100 dark:border-gray-700 group-hover:border-primary/30 group-hover:-translate-y-1 transition-all duration-300">
                <span class="material-icons text-4xl text-primary">playlist_add_check</span>
              </div>
              <div
                class="absolute -top-3 -right-3 w-8 h-8 bg-primary text-white rounded-full flex items-center justify-center font-bold text-sm border-4 border-background-light dark:border-background-dark">
                2
              </div>
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">Elija su Cobertura</h3>
            <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed px-2">
              Compare las mejores aseguradoras mexicanas lado a lado y elija el plan que se adapte a su presupuesto y necesidades.
            </p>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="relative group">
          <div class="flex flex-col items-center text-center">
            <div class="relative mb-6">
              <div
                class="w-24 h-24 bg-white dark:bg-gray-800 rounded-2xl shadow-xl shadow-gray-200/50 dark:shadow-none flex items-center justify-center border border-gray-100 dark:border-gray-700 group-hover:border-primary/30 group-hover:-translate-y-1 transition-all duration-300">
                <span class="material-icons text-4xl text-primary">mark_email_read</span>
              </div>
              <div
                class="absolute -top-3 -right-3 w-8 h-8 bg-primary text-white rounded-full flex items-center justify-center font-bold text-sm border-4 border-background-light dark:border-background-dark">
                3
              </div>
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">Reciba su Póliza al Instante</h3>
            <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed px-2">
              Pague de forma segura y reciba su comprobante oficial de seguro directamente en su correo electrónico de inmediato.
            </p>
          </div>
        </div>

        <!-- Step 4 -->
        <div class="relative group">
          <div class="flex flex-col items-center text-center">
            <div class="relative mb-6">
              <div
                class="w-24 h-24 bg-white dark:bg-gray-800 rounded-2xl shadow-xl shadow-gray-200/50 dark:shadow-none flex items-center justify-center border border-gray-100 dark:border-gray-700 group-hover:border-primary/30 group-hover:-translate-y-1 transition-all duration-300">
                <span class="material-icons text-4xl text-primary">travel_explore</span>
              </div>
              <div
                class="absolute -top-3 -right-3 w-8 h-8 bg-primary text-white rounded-full flex items-center justify-center font-bold text-sm border-4 border-background-light dark:border-background-dark">
                4
              </div>
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">Viaje con Tranquilidad</h3>
            <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed px-2">
              Cruce la frontera sabiendo que está completamente protegido, en cumplimiento con la ley mexicana y con soporte 24/7.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Feature Spotlight / Context -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-24">
      <div
        class="bg-white dark:bg-gray-900 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-800 overflow-hidden">
        <div class="grid lg:grid-cols-2 gap-0">
          <div class="p-8 sm:p-12 lg:p-16 flex flex-col justify-center order-2 lg:order-1">
            <h3 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-6">
              Por qué los viajeros confían en nosotros para su travesía
            </h3>
            <div class="space-y-6">
              <div class="flex gap-4">
                <div class="flex-shrink-0 w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center">
                  <span class="material-icons text-primary">timer</span>
                </div>
                <div>
                  <h4 class="font-bold text-gray-900 dark:text-white text-lg">Cobertura Instantánea</h4>
                  <p class="text-gray-600 dark:text-gray-400 mt-1 text-sm">Sin períodos de espera. Su póliza es válida desde el momento en que se procesa su pago.</p>
                </div>
              </div>
              <div class="flex gap-4">
                <div class="flex-shrink-0 w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center">
                  <span class="material-icons text-primary">lock_person</span>
                </div>
                <div>
                  <h4 class="font-bold text-gray-900 dark:text-white text-lg">Datos Seguros</h4>
                  <p class="text-gray-600 dark:text-gray-400 mt-1 text-sm">Utilizamos cifrado de nivel bancario para proteger su información personal y de pago.</p>
                </div>
              </div>
              <div class="flex gap-4">
                <div class="flex-shrink-0 w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center">
                  <span class="material-icons text-primary">support_agent</span>
                </div>
                <div>
                  <h4 class="font-bold text-gray-900 dark:text-white text-lg">Soporte Bilingüe</h4>
                  <p class="text-gray-600 dark:text-gray-400 mt-1 text-sm">¿Necesita ayuda? Nuestro equipo bilingüe de reclamaciones y soporte está disponible 24/7.</p>
                </div>
              </div>
            </div>
          </div>
          <div class="bg-gray-100 dark:bg-gray-800 relative h-64 lg:h-auto order-1 lg:order-2">
            <!-- Abstract map background for visual interest -->
            <div class="absolute inset-0 bg-cover bg-center opacity-80"
              data-alt="Primer plano de un mapa y documentos de viaje representando un trayecto"
              style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuDUGMrvy2CIMxgxahcRLFpT28h4S7vPvdUbvlRlJt7XB-tlXawH5KPZPFRpjj8hZIX7RaJlDBJq_EbX2GpwRyqRL_Ii8v514-TF03wyMCrgMDUDwM6dmEMMrctfjuQY8DjNSs8AKlWCROBrCJXbxuFXtM1CiJjsKUbPX3z7RYPRatcgPLQGEnDcwQqyoEWGttJnQhRb7l2CBUXMK28Y6-Rjosu4DYyJDPwEdWNS9NszAVmvchAEtisAESxx9LV7O6t6V1rzuy3esmY8');">
            </div>
            <div
              class="absolute inset-0 bg-gradient-to-l from-transparent to-white dark:to-gray-900 lg:bg-gradient-to-r lg:from-white lg:dark:from-gray-900 lg:to-transparent">
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- CTA Section -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mt-20 sm:mt-32 text-center">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-6">¿Listo para partir?</h2>
      <p class="text-lg text-gray-600 dark:text-gray-400 mb-8 max-w-2xl mx-auto">
        No se detenga en la frontera. Obtenga su seguro de auto para México en minutos y disfrute su viaje sin preocupaciones.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/es/contact"
          class="w-full sm:w-auto px-8 py-4 bg-primary hover:bg-blue-700 text-white font-bold rounded-lg shadow-lg shadow-primary/30 transition-all transform hover:-translate-y-1 flex items-center justify-center gap-2">
          Inicie su Cotización Ahora
          <span class="material-icons text-sm">arrow_forward</span>
        </a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  body {
    font-family: 'Plus Jakarta Sans', sans-serif;
  }
</style>
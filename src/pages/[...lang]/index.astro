        >
          <div
            class="w-14 h-14 bg-blue-50 dark:bg-slate-700 rounded-lg flex items-center justify-center mb-6"
          >
            <span class="material-icons text-3xl text-primary">lock</span>
          </div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3">
            {t.whyLawCard3Title}
          </h3>
          <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
            {t.whyLawCard3Desc}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- What Happens in an Accident -->
  <section class="py-24 bg-primary text-white relative overflow-hidden">
    <div
      class="absolute inset-0 opacity-10"
      style="background-image: radial-gradient(#ffffff 1px, transparent 1px); background-size: 30px 30px;"
    >
    </div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold mb-6">
            {t.accidentTitle}
          </h2>
          <p class="text-blue-100 mb-8 text-lg">
            {t.accidentSubtitle}
          </p>
          <a
            class="inline-flex items-center gap-2 bg-white text-primary font-bold px-6 py-3 rounded-lg hover:bg-blue-50 transition-colors"
            href={l("/how-it-works")}
          >
            {t.accidentCta}
            <span class="material-icons">arrow_forward</span>
          </a>
        </div>
        <div class="space-y-6">
          <!-- Step 1 -->
          <div class="flex gap-4">
            <div class="flex-shrink-0">
              <div
                class="w-10 h-10 rounded-full bg-blue-400/30 border border-blue-300 flex items-center justify-center font-bold text-lg"
              >
                1
              </div>
            </div>
            <div
              class="bg-white/10 backdrop-blur-md p-6 rounded-xl border border-white/10 flex-1"
            >
              <h4 class="font-bold text-lg mb-2">{t.accidentStep1Title}</h4>
              <p class="text-blue-100 text-sm">
                {t.accidentStep1Desc}
              </p>
            </div>
          </div>
          <!-- Step 2 -->
          <div class="flex gap-4">
            <div class="flex-shrink-0">
              <div
                class="w-10 h-10 rounded-full bg-blue-400/30 border border-blue-300 flex items-center justify-center font-bold text-lg"
              >
                2
              </div>
            </div>
            <div
              class="bg-white/10 backdrop-blur-md p-6 rounded-xl border border-white/10 flex-1"
            >
              <h4 class="font-bold text-lg mb-2">{t.accidentStep2Title}</h4>
              <p class="text-blue-100 text-sm">
                {t.accidentStep2Desc}
              </p>
            </div>
          </div>
          <!-- Step 3 -->
          <div class="flex gap-4">
            <div class="flex-shrink-0">
              <div
                class="w-10 h-10 rounded-full bg-blue-400/30 border border-blue-300 flex items-center justify-center font-bold text-lg"
              >
                3
              </div>
            </div>
            <div
              class="bg-white/10 backdrop-blur-md p-6 rounded-xl border border-white/10 flex-1"
            >
              <h4 class="font-bold text-lg mb-2">{t.accidentStep3Title}</h4>
              <p class="text-blue-100 text-sm">
                {t.accidentStep3Desc}
              </p>
            </div>
          </div>
          <!-- Step 4 -->
          <div class="flex gap-4">
            <div class="flex-shrink-0">
              <div
                class="w-10 h-10 rounded-full bg-blue-400/30 border border-blue-300 flex items-center justify-center font-bold text-lg"
              >
                4
              </div>
            </div>
            <div
              class="bg-white/10 backdrop-blur-md p-6 rounded-xl border border-white/10 flex-1"
            >
              <h4 class="font-bold text-lg mb-2">{t.accidentStep4Title}</h4>
              <p class="text-blue-100 text-sm">

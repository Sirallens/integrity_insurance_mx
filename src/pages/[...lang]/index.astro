                <span class="material-icons text-red-500 mt-0.5"
                  >highlight_off</span
                >
                <p
                  class="text-slate-600 dark:text-slate-300 text-sm"
                  set:html={t.warningLi1Html}
                />
              </div>
              <div
                class="flex items-start gap-3 p-4 bg-white dark:bg-slate-900 rounded-lg border border-slate-100 dark:border-slate-700 shadow-sm"
              >
                <span class="material-icons text-red-500 mt-0.5"
                  >highlight_off</span
                >
                <p
                  class="text-slate-600 dark:text-slate-300 text-sm"
                  set:html={t.warningLi2Html}
                />
              </div>

const t = content[lang];
---

<BaseLayout title={t.title} description={t.description}>
  <Navigation lang={lang} client:load pathname={Astro.url.pathname} />

  <!-- Hero Section -->
  <header class="relative pt-20 flex items-center min-h-[85vh]">
    <!-- Background Image with Overlay -->
    <div class="absolute inset-0 z-0">
      <img
        alt={lang === "es" ? "Viaje familiar en carretera" : "Family road trip"}

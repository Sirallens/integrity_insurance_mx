          </div>
        </div>
        <div>
          <div
            class="inline-block px-4 py-1.5 rounded-full bg-primary/10 text-primary font-semibold text-sm mb-4"
          >
            {t.factsBadge}
          </div>
          <h2
            class="text-4xl font-bold text-slate-900 dark:text-white mb-6"
            set:html={t.factsTitleHtml}
          />
          <p
            class="text-lg text-slate-600 dark:text-slate-300 mb-6 leading-relaxed"
            set:html={t.factsIntroHtml}
          />
          <p class="text-slate-600 dark:text-slate-300 mb-8 leading-relaxed">
            {t.factsBody}
          </p>
          <a
            class="text-primary font-bold flex items-center hover:gap-2 transition-all"
            href={l("/coverage-options")}
          >
            {t.factsCta}
            <span class="material-icons text-sm ml-1">arrow_forward</span>
          </a>
        </div>

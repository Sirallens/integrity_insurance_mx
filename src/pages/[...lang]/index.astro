            {t.whyChooseSubtitle}
          </p>
          <div
            class="aspect-video rounded-xl overflow-hidden shadow-2xl relative"
          >
            <img
              alt={lang === "es" ? "Viajeros felices" : "Happy travelers"}
              class="w-full h-full object-cover"

    class="py-24 bg-white dark:bg-slate-900 relative overflow-hidden"
    id="validity"
  >
    <div
      class="absolute top-0 right-0 w-1/3 h-full bg-primary/5 -skew-x-12 translate-x-20"
    >
    </div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid md:grid-cols-2 gap-16 items-center">
        <div class="relative">
          <div
            class="absolute -top-10 -left-10 w-20 h-20 bg-red-100 rounded-full blur-2xl"
          >
          </div>
          <div
            class="relative bg-slate-50 dark:bg-slate-800 p-8 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xl"
          >
            <div class="flex items-center gap-4 mb-6">
              <div
                class="w-12 h-12 rounded-full bg-red-100 dark:bg-red-900/30 flex items-center justify-center text-red-600 dark:text-red-400"
              >
                <span class="material-icons text-2xl">warning</span>
              </div>
              <div>
                <h3 class="text-xl font-bold text-slate-900 dark:text-white">
                  {t.warningTitle}
                </h3>
                <p class="text-sm text-slate-500 dark:text-slate-400">
                  {t.warningSubtitle}
                </p>
              </div>
            </div>
            <div class="space-y-4">
              <div
                class="flex items-start gap-3 p-4 bg-white dark:bg-slate-900 rounded-lg border border-slate-100 dark:border-slate-700 shadow-sm"

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navigation from "../../components/Navigation.svelte";
import Footer from "../../components/Footer.astro";
import { getRelativeLocaleUrl } from "../../i18n/utils";
import { defaultLang, languages } from "../../i18n/ui";

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang: lang === defaultLang ? undefined : lang },
    props: { lang: lang as "en" | "es" },
  }));
}

const { lang } = Astro.props as { lang: "en" | "es" };
const l = (path: string) => getRelativeLocaleUrl(lang, path);

const content = {
  en: {
    title: "Mexico Coverage Options - Integrity Mexico Insurance",
    description:
      "U.S. insurance policies generally stop at the border. Choose a plan specifically designed to keep you legal and protected on Mexican roads.",
    badge: "Valid for all U.S. Drivers",
    heroTitleHtml:
      'Coverage Options Built for <span class="text-primary relative inline-block">Your Trip<svg class="absolute bottom-2 left-0 w-full h-3 -z-10 opacity-30" preserveAspectRatio="none" viewBox="0 0 100 10"><path class="text-blue-400" d="M0 5 Q 50 10 100 5" fill="transparent" stroke="currentColor" stroke-width="8"></path></svg></span>',
    heroSubtitle:
      "U.S. insurance policies generally stop at the border. Choose a plan specifically designed to keep you legal and protected on Mexican roads.",
    card1Badge: "Mandatory",
    card1Title: "Liability",
    card1Desc:
      "Essential coverage required by Mexican federal law for all drivers.",
    card1Li1: "Third-party bodily injury",
    card1Li2: "Property damage liability",
    card1Li3: "Required for legal driving",
    card1Cta: "Get Covered Now",
    card2Badge: "MOST POPULAR",
    card2Title: "Full Coverage",
    card2Desc:
      "Comprehensive protection for your vehicle, plus theft coverage.",
    card2Li1: "Physical damage to your car",
    card2Li2: "Total theft coverage",
    card2Li3: "Plus Liability coverage",
    card2Cta: "Get Covered Now",
    card3Title: "Full Coverage Elite",
    card3Desc:
      "Crucial support if you are detained following a serious accident.",
    card3Li1: "Liability Package",
    card3Li2: "Full Coverage Package",
    card3Li3: "Vandalism and Partial Theft",
    card3Cta: "Get Covered Now",
    teaserTitle: "Not sure what you need?",
    teaserDesc:
      "Our licensed agents can help you build the perfect policy for your vehicle and destination.",
    teaserCta: "Talk to an Agent",
  },
  es: {
    title: "Opciones de Cobertura para México - Integrity Mexico Seguros",
    description:
      "Las pólizas de seguro de EE. UU. generalmente no aplican en México. Elija un plan diseñado específicamente para mantenerle legal y protegido en las carreteras mexicanas.",
    badge: "Válido para todos los conductores de EE. UU.",
    heroTitleHtml:
      'Opciones de Cobertura Diseñadas para <span class="text-primary relative inline-block">Su Viaje<svg class="absolute bottom-2 left-0 w-full h-3 -z-10 opacity-30" preserveAspectRatio="none" viewBox="0 0 100 10"><path class="text-blue-400" d="M0 5 Q 50 10 100 5" fill="transparent" stroke="currentColor" stroke-width="8"></path></svg></span>',
    heroSubtitle:
      "Las pólizas de seguro de EE. UU. generalmente no aplican en México. Elija un plan diseñado específicamente para mantenerle legal y protegido en las carreteras mexicanas.",
    card1Badge: "Obligatorio",
    card1Title: "Responsabilidad Civil",
    card1Desc:
      "Cobertura esencial requerida por la ley federal mexicana para todos los conductores.",
    card1Li1: "Lesiones corporales a terceros",
    card1Li2: "Daños a la propiedad de terceros",
    card1Li3: "Requerido para conducir legalmente",
    card1Cta: "Obtenga Cobertura Ahora",
    card2Badge: "MÁS POPULAR",
    card2Title: "Cobertura Amplia",
    card2Desc:
      "Protección integral para su vehículo, más cobertura contra robo.",
    card2Li1: "Daños físicos a su auto",
    card2Li2: "Cobertura de robo total",
    card2Li3: "Responsabilidad Civil Plus",
    card2Cta: "Obtenga Cobertura Ahora",
    card3Title: "Cobertura Amplia Elite",
    card3Desc: "Apoyo crucial si es detenido tras un accidente grave.",
    card3Li1: "Paquete de Responsabilidad Civil",
    card3Li2: "Paquete de Cobertura Amplia",
    card3Li3: "Vandalism y robo parcial",
    card3Cta: "Obtenga Cobertura Ahora",
    teaserTitle: "¿No sabe qué necesita?",
    teaserDesc:
      "Nuestros agentes con licencia pueden ayudarle a encontrar la póliza perfecta para su vehículo y destino.",
    teaserCta: "Hablar con un Agente",
  },
};

const t = content[lang];
---

<BaseLayout title={t.title} description={t.description}>
  <Navigation lang={lang} client:load pathname={Astro.url.pathname} />

  <!-- Hero Section -->
  <section class="relative pt-16 pb-12 overflow-hidden">
    <div
      class="absolute inset-0 opacity-50 pointer-events-none"
      style="background-image: radial-gradient(rgba(17, 82, 212, 0.1) 1px, transparent 1px); background-size: 24px 24px;"
    >
    </div>
    <div
      class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center"
    >
      <div
        class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary dark:text-blue-300 mb-6"
      >
        <span class="material-icons-outlined text-sm">verified</span>
        <span class="text-sm font-semibold">{t.badge}</span>
      </div>
      <h1
        class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 dark:text-white mb-6"
        set:html={t.heroTitleHtml}
      />
      <p
        class="text-lg md:text-xl text-slate-600 dark:text-slate-400 max-w-2xl mx-auto mb-8 leading-relaxed"
      >
        {t.heroSubtitle}
      </p>
    </div>
  </section>

  <!-- Content Grid Section -->
  <section class="flex-grow pb-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Grid Layout -->
      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 xl:grid-cols-3 gap-6"
      >
        <!-- Card 1: Liability -->
        <div
          class="group relative bg-white dark:bg-slate-800 rounded-2xl p-6 shadow-sm hover:shadow-xl transition-all duration-300 border border-slate-200 dark:border-slate-700 flex flex-col h-full hover:border-primary/50 dark:hover:border-primary/50"
        >
          <div
            class="absolute top-0 left-0 w-full h-1.5 bg-slate-400 rounded-t-2xl group-hover:bg-primary transition-colors"
          >
          </div>
          <div class="mb-5 flex justify-between items-start">
            <div
              class="h-12 w-12 rounded-xl bg-blue-50 dark:bg-blue-900/20 flex items-center justify-center text-primary dark:text-blue-400 group-hover:scale-110 transition-transform duration-300"
            >
              <span class="material-icons-outlined text-2xl">gavel</span>
            </div>
            <span
              class="px-2.5 py-1 rounded-md bg-slate-100 dark:bg-slate-700 text-xs font-bold text-slate-600 dark:text-slate-300 uppercase tracking-wide"
              >{t.card1Badge}</span
            >
          </div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">
            {t.card1Title}
          </h3>
          <p class="text-sm text-slate-500 dark:text-slate-400 mb-6">
            {t.card1Desc}
          </p>
          <ul class="space-y-3 mb-8 flex-grow">
            <li class="flex items-start gap-2.5">
              <span
                class="material-icons-outlined text-secondary-green text-lg shrink-0"
                >check_circle</span
              >
              <span class="text-sm text-slate-600 dark:text-slate-300"
                >{t.card1Li1}</span
              >
            </li>
            <li class="flex items-start gap-2.5">
              <span
                class="material-icons-outlined text-secondary-green text-lg shrink-0"
                >check_circle</span
              >
              <span class="text-sm text-slate-600 dark:text-slate-300"
                >{t.card1Li2}</span
              >
            </li>
            <li class="flex items-start gap-2.5">
              <span
                class="material-icons-outlined text-secondary-green text-lg shrink-0"
                >check_circle</span
              >
              <span class="text-sm text-slate-600 dark:text-slate-300"
                >{t.card1Li3}</span
              >
            </li>
          </ul>
          <a
            href={l("/contact")}
            class="w-full py-3 rounded-xl bg-secondary-green hover:bg-secondary-green-hover text-white font-bold shadow-lg shadow-green-900/10 transition-all flex items-center justify-center gap-2 group-hover:translate-y-[-2px] text-center"
          >
            {t.card1Cta}
            <span class="material-icons-outlined text-sm">arrow_forward</span>
          </a>
        </div>

        <!-- Card 2: Full Coverage -->
        <div
          class="group relative bg-white dark:bg-slate-800 rounded-2xl p-6 shadow-md hover:shadow-xl transition-all duration-300 border border-primary/20 dark:border-primary/40 ring-1 ring-primary/5 flex flex-col h-full transform hover:-translate-y-1"
        >
          <div
            class="absolute top-0 right-0 bg-primary text-white text-xs font-bold px-3 py-1 rounded-bl-lg rounded-tr-xl"
          >
            {t.card2Badge}
          </div>
          <div
            class="absolute top-0 left-0 w-full h-1.5 bg-primary rounded-t-2xl"
          >
          </div>
          <div class="mb-5 flex justify-between items-start">
            <div
              class="h-12 w-12 rounded-xl bg-primary/10 flex items-center justify-center text-primary dark:text-blue-400 group-hover:scale-110 transition-transform duration-300"
            >
              <span class="material-icons-outlined text-2xl"
                >directions_car</span
              >
            </div>
          </div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">
            {t.card2Title}
          </h3>
          <p class="text-sm text-slate-500 dark:text-slate-400 mb-6">
            {t.card2Desc}
          </p>

          <ul class="space-y-3 mb-8 flex-grow">
            <li class="flex items-start gap-2.5">
              <span
                class="material-icons-outlined text-secondary-green text-lg shrink-0"
                >check_circle</span
              >
              <span class="text-sm text-slate-600 dark:text-slate-300"
                >{t.card2Li1}</span
              >
            </li>
            <li class="flex items-start gap-2.5">
              <span
                class="material-icons-outlined text-secondary-green text-lg shrink-0"
                >check_circle</span
              >
              <span class="text-sm text-slate-600 dark:text-slate-300"
                >{t.card2Li2}</span
              >
            </li>
            <li class="flex items-start gap-2.5">
              <span
                class="material-icons-outlined text-secondary-green text-lg shrink-0"
                >check_circle</span
              >
              <span class="text-sm text-slate-600 dark:text-slate-300"
                >{t.card2Li3}</span
              >
            </li>
          </ul>
          <a
            href={l("/contact")}
            class="w-full py-3 rounded-xl bg-secondary-green hover:bg-secondary-green-hover text-white font-bold shadow-lg shadow-green-900/10 transition-all flex items-center justify-center gap-2 group-hover:translate-y-[-2px] text-center"
          >
            {t.card2Cta}
            <span class="material-icons-outlined text-sm">arrow_forward</span>
          </a>
        </div>

        <!-- Card 3: Full Coverage Elite -->
        <div
          class="group relative bg-white dark:bg-slate-800 rounded-2xl p-6 shadow-sm hover:shadow-xl transition-all duration-300 border border-slate-200 dark:border-slate-700 flex flex-col h-full hover:border-primary/50 dark:hover:border-primary/50"
        >
          <div
            class="absolute top-0 left-0 w-full h-1.5 bg-slate-400 rounded-t-2xl group-hover:bg-primary transition-colors"
          >
          </div>
          <div class="mb-5 flex justify-between items-start">
            <div
              class="h-12 w-12 rounded-xl bg-blue-50 dark:bg-blue-900/20 flex items-center justify-center text-primary dark:text-blue-400 group-hover:scale-110 transition-transform duration-300"
            >
              <span class="material-icons-outlined text-2xl">balance</span>
            </div>
          </div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">
            {t.card3Title}
          </h3>
          <p class="text-sm text-slate-500 dark:text-slate-400 mb-6">
            {t.card3Desc}
          </p>

          <ul class="space-y-3 mb-8 flex-grow">
            <li class="flex items-start gap-2.5">
              <span
                class="material-icons-outlined text-secondary-green text-lg shrink-0"
                >check_circle</span
              >
              <span class="text-sm text-slate-600 dark:text-slate-300"
                >{t.card3Li1}</span
              >
            </li>
            <li class="flex items-start gap-2.5">
              <span
                class="material-icons-outlined text-secondary-green text-lg shrink-0"
                >check_circle</span
              >
              <span class="text-sm text-slate-600 dark:text-slate-300"
                >{t.card3Li2}</span
              >
            </li>
            <li class="flex items-start gap-2.5">
              <span
                class="material-icons-outlined text-secondary-green text-lg shrink-0"
                >check_circle</span
              >
              <span class="text-sm text-slate-600 dark:text-slate-300"
                >{t.card3Li3}</span
              >
            </li>
          </ul>
          <a
            href={l("/contact")}
            class="w-full py-3 rounded-xl bg-secondary-green hover:bg-secondary-green-hover text-white font-bold shadow-lg shadow-green-900/10 transition-all flex items-center justify-center gap-2 group-hover:translate-y-[-2px] text-center"
          >
            {t.card3Cta}
            <span class="material-icons-outlined text-sm">arrow_forward</span>
          </a>
        </div>
      </div>

      <!-- FAQ Teaser / Additional CTA -->
      <div
        class="mt-16 rounded-3xl bg-primary text-white p-8 md:p-12 relative overflow-hidden"
      >
        <div
          class="absolute top-0 right-0 w-64 h-64 bg-white/10 rounded-full blur-3xl -mr-16 -mt-16 pointer-events-none"
        >
        </div>
        <div
          class="absolute bottom-0 left-0 w-64 h-64 bg-black/10 rounded-full blur-3xl -ml-16 -mb-16 pointer-events-none"
        >
        </div>
        <div
          class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-8"
        >
          <div class="max-w-2xl">
            <h2 class="text-2xl md:text-3xl font-bold mb-3">
              {t.teaserTitle}
            </h2>
            <p class="text-blue-100 text-lg">
              {t.teaserDesc}
            </p>
          </div>
          <div class="flex gap-4">
            <a
              href={l("/contact")}
              class="bg-white text-primary hover:bg-blue-50 px-6 py-3 rounded-xl font-bold transition-colors shadow-lg text-center inline-block"
            >
              {t.teaserCta}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  :global(.bg-secondary-green) {
    background-color: #16a34a;
  }

  :global(.bg-secondary-green-hover):hover,
  :global(.hover\:bg-secondary-green-hover):hover {
    background-color: #15803d;
  }

  :global(.text-secondary-green) {
    color: #16a34a;
  }

  :global(.shadow-green-900\/10) {
    box-shadow: 0 10px 15px -3px rgba(20, 83, 45, 0.1);
  }
</style>

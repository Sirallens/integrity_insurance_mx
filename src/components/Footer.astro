---
import {
  getLangFromUrl,
  useTranslations,
  getRelativeLocaleUrl,
} from "../i18n/utils";
import "@fortawesome/fontawesome-free/css/all.min.css";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const l = (path: string) => getRelativeLocaleUrl(lang, path);
---

<footer
  class="bg-gray-900 dark:bg-black text-gray-300 py-12 border-t border-gray-800"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
      <!-- Company Info -->
      <div class="col-span-1 md:col-span-2">
        <div class="flex items-center gap-2 mb-4">
          <span class="font-display font-bold text-xl text-white tracking-wide">
            INTEGRITY
          </span>
          <span
            class="text-xs text-secondary border border-secondary px-1 rounded uppercase"
          >
            Agente de Seguros
          </span>
        </div>
        <p class="text-sm text-gray-400 max-w-xs leading-relaxed">
          {t("footer.companyDescription")}
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h4
          class="text-white font-semibold mb-4 uppercase text-sm tracking-wider"
        >
          {t("footer.quickLinks")}
        </h4>
        <ul class="space-y-2 text-sm">
          <li>
            <a class="hover:text-white transition-colors" href={l("/faq")}
              >{t("nav.faq")}</a
            >
          </li>
          <li>
            <a
              class="hover:text-white transition-colors"
              href={l("/why-insurance")}>{t("footer.whyInsurance")}</a
            >
          </li>
          <li>
            <a
              class="hover:text-white transition-colors"
              href={l("/how-it-works")}>{t("nav.howItWorks")}</a
            >
          </li>
          <li>
            <a class="hover:text-white transition-colors" href={l("/contact")}
              >{t("footer.contact")}</a
            >
          </li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4
          class="text-white font-semibold mb-4 uppercase text-sm tracking-wider"
        >
          {t("footer.contact")}
        </h4>
        <ul class="space-y-2 text-sm">
          <li class="flex items-center gap-2">
            <i class="fa-brands fa-whatsapp text-2xl"></i>
            +1 (956) 6160-0306
          </li>
          <li class="flex items-center gap-2">
            <i class="fa-regular fa-envelope text-2xl"></i>
            contact@integrityseguros.com
          </li>
          <li class="flex items-center gap-2">
            <i class="fa-solid fa-map-location-dot text-xl"></i>
            Blvd Las Fuentes 426 Col Las Fuentes Secc Lomas, Reynosa, Tamaulipas,
            Mexico 88703
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Section -->
    <div
      class="border-t border-gray-800 pt-8 flex flex-col md:flex-row justify-between items-center"
    >
      <p class="text-xs text-gray-500">
        © 2026 Integrity Agente de Seguros. {t("footer.rights")}
      </p>
      <div class="flex space-x-4 mt-4 md:mt-0">
        <a
          class="text-gray-400 hover:text-white transition-colors"
          href="https://www.facebook.com/integrityagentedeseguros"
          aria-label="Facebook"
        >
          <span class="sr-only">Facebook</span>
          <i class="fa-brands fa-facebook text-2xl"></i>
        </a>
        <a
          class="text-gray-400 hover:text-white transition-colors"
          href="https://www.instagram.com/integrity.agentes/"
          aria-label="Instagram"
        >
          <span class="sr-only">Instagram</span>
          <i class="fa-brands fa-instagram text-2xl"></i>
        </a>
      </div>
    </div>
  </div>
</footer>
